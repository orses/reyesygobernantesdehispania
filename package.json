{
  "name": "gobernantes-de-españa",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": "22.22.3"
  },
  "packageManager": "npm@10.9.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:all": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "security:lockfile": "npm audit",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run bundle:check && npm run security:lockfile",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --max-warnings=0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@radix-ui/react-slot": "1.3.3",
    "clsx": "^2.1.1",
    "idb-keyval": "6.3.0",
    "lucide-react": "1.47.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "10.1.0",
    "recharts": "3.10.1",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "10.6.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
